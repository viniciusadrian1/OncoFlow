# Somente nomes de variáveis. Configure os valores privados no ambiente do servidor.
# Persistência da função Vercel: escolha um dos pares Upstash/KV.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
KV_REST_API_URL=
KV_REST_API_TOKEN=
ONCOFLOW_REDIS_NAMESPACE=
ONCOFLOW_DEMO_AUTO_CONNECT=
ONCOFLOW_ALLOWED_ORIGINS=
# Variável de sistema Vercel; fornecida pela plataforma.
VERCEL_PROJECT_PRODUCTION_URL=
# Execução local; os padrões estão no guia docs/connected-demo.md.
PORT=
ONCOFLOW_DEMO_STATE_PATH=
ONCOFLOW_PATIENT_WEB_DIR=
# Transcrição da experiência web legada, opcional.
GEMINI_API_KEY=
